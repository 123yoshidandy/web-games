{
    "name": "ホラーファイド",
    "short_name": "ホラーファイド",
    "description": "村に現れた怪物たちを、英雄が力を合わせて退治する協力ゲーム。仲間を CPU に任せて1人でも遊べます",
    "lang": "ja",
    "start_url": "./",
    "scope": "./",
    "display": "fullscreen",
    "display_override": [
        "fullscreen",
        "standalone"
    ],
    "orientation": "portrait",
    "background_color": "#16131f",
    "theme_color": "#16131f",
    "icons": [
        {
            "src": "icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "favicon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        }
    ]
}
