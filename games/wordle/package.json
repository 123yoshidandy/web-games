{
  "name": "wordle",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build:server": "esbuild server/src/handler.js --bundle --platform=node --format=esm --target=node22 --external:@aws-sdk/* --outfile=server/dist/handler.mjs",
    "dev:server": "node server/dev-server.js",
    "deploy:server": "npm run build:server && cd server && sam deploy"
  },
  "dependencies": {
    "netplay-kit": "*"
  },
  "portal": {
    "original": "Wordle",
    "aliases": [
      "わーどる",
      "にほんごわーどる"
    ],
    "genres": [
      "言葉",
      "パズル"
    ],
    "players": [
      1,
      2,
      3,
      4
    ]
  },
  "standards": {
    "skip": {
      "cpu": "答えを当てる1人用の言葉のパズルで、競う相手はオンラインの人だけ（CPU の相手がいない）",
      "replay": "局面は答えと入力した単語の一覧そのもの。手番の操作を記録して再現する作りが当てはまらない"
    }
  }
